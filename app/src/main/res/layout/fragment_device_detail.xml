<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3E9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Movie Backdrop -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="250dp">

            <ImageView
                android:id="@+id/iv_detail_backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#155456"
                android:scaleType="centerCrop"
                android:contentDescription="Movie backdrop"/>

            <ImageButton
                android:id="@+id/btnDetailBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="18dp"
                android:background="@drawable/bg_back_button"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Go back"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:elevation="6dp"
                app:tint="#155456" />
        </FrameLayout>

        <!-- Movie Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Movie Poster and Basic Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="115dp"
                    android:layout_height="165dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:id="@+id/iv_detail_poster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="#DAD9CE"
                        android:contentDescription="Movie poster"/>

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_detail_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Movie Title"
                        android:textColor="#202B28"
                        android:textSize="23sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_detail_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2026"
                        android:textColor="#85877F"
                        android:textSize="14sp"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:id="@+id/tv_detail_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★ 8.5 / 10"
                        android:textColor="#155456"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:id="@+id/tv_detail_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Language: English"
                        android:textColor="#85877F"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Favourite Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_detail_favourite"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Add to Favourites"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                app:backgroundTint="#155456"
                app:cornerRadius="14dp"/>

            <!-- Overview -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overview"
                android:textColor="#202B28"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="30dp"/>

            <TextView
                android:id="@+id/tv_detail_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Movie description will appear here."
                android:textColor="#666B65"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"
                android:layout_marginTop="12dp"/>

            <!-- Additional Information -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Movie Information"
                android:textColor="#202B28"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"/>

            <TextView
                android:id="@+id/tv_detail_original_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Original title"
                android:textColor="#666B65"
                android:textSize="14sp"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/tv_detail_vote_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Votes: 0"
                android:textColor="#666B65"
                android:textSize="14sp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
